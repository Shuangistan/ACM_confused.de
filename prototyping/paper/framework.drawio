          <mxGeometry x="60" y="10" width="700" height="34" as="geometry"/>
        </mxCell>

        <mxCell id="f_start" value="START" style="ellipse;html=1;fillColor=#EFEFEC;strokeColor=#7A7A72;fontColor=#3A3A36;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="56" width="140" height="46" as="geometry"/></mxCell>

        <mxCell id="f_d1" value="phase == deciding ?" style="rhombus;html=1;fillColor=#F4FAF6;strokeColor=#2E6F4E;fontColor=#1E4D36;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="136" width="260" height="84" as="geometry"/></mxCell>

        <mxCell id="f_intake" value="intake&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;was this purely conversational?&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#E6EDF3;strokeColor=#2C5F7C;fontColor=#1F4459;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="256" width="250" height="54" as="geometry"/></mxCell>
        <mxCell id="f_d2" value="a decision described ?" style="rhombus;html=1;fillColor=#F4FAF6;strokeColor=#2E6F4E;fontColor=#1E4D36;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="340" width="270" height="84" as="geometry"/></mxCell>
        <mxCell id="f_end1" value="END" style="ellipse;html=1;fillColor=#EFEFEC;strokeColor=#7A7A72;fontColor=#3A3A36;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="130" height="44" as="geometry"/></mxCell>

        <mxCell id="f_suggest"  value="suggest&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;estimates the four inputs; the user overrides&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#E6EDF3;strokeColor=#2C5F7C;fontColor=#1F4459;fontSize=12;" vertex="1" parent="1"><mxGeometry x="435" y="470" width="250" height="54" as="geometry"/></mxCell>
        <mxCell id="f_classify" value="classify&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;the matrix, executed&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#E2EEE6;strokeColor=#2E6F4E;fontColor=#1E4D36;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="435" y="558" width="250" height="54" as="geometry"/></mxCell>
        <mxCell id="f_extract"  value="extract&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;free text &#8594; ground atoms (Sonnet floor)&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#E6EDF3;strokeColor=#2C5F7C;fontColor=#1F4459;fontSize=12;" vertex="1" parent="1"><mxGeometry x="435" y="646" width="250" height="54" as="geometry"/></mxCell>
        <mxCell id="f_derive"   value="derive&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;forward chaining over approved clauses&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#E2EEE6;strokeColor=#2E6F4E;fontColor=#1E4D36;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="435" y="734" width="250" height="54" as="geometry"/></mxCell>

        <mxCell id="f_d3" value="covered by approved logic ?" style="rhombus;html=1;fillColor=#F4FAF6;strokeColor=#2E6F4E;fontColor=#1E4D36;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="820" width="300" height="92" as="geometry"/></mxCell>

        <mxCell id="f_propose" value="propose&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;draft a clause, then run it against this very case&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#E6EDF3;strokeColor=#2C5F7C;fontColor=#1F4459;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="839" width="280" height="54" as="geometry"/></mxCell>

        <mxCell id="f_gate"    value="gate&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;has a person already ruled on this logic?&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#E2EEE6;strokeColor=#2E6F4E;fontColor=#1E4D36;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="435" y="952" width="250" height="54" as="geometry"/></mxCell>
        <mxCell id="f_respond" value="respond&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;the answer is written either way&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#E6EDF3;strokeColor=#2C5F7C;fontColor=#1F4459;fontSize=12;" vertex="1" parent="1"><mxGeometry x="435" y="1040" width="250" height="54" as="geometry"/></mxCell>

        <mxCell id="f_d4" value="blocked ?" style="rhombus;html=1;fillColor=#F4FAF6;strokeColor=#2E6F4E;fontColor=#1E4D36;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1126" width="220" height="84" as="geometry"/></mxCell>

        <mxCell id="f_park"   value="park&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;the draft goes to the expert&lt;br&gt;nothing is said to the person&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#F8E9E9;strokeColor=#A63D40;fontColor=#7A2E30;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="1242" width="270" height="62" as="geometry"/></mxCell>
        <mxCell id="f_record" value="record&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;the case is stored and abstracted&lt;br&gt;even when the rules already decided it&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#E6EDF3;strokeColor=#2C5F7C;fontColor=#1F4459;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="1242" width="280" height="62" as="geometry"/></mxCell>

        <mxCell id="f_end2" value="END" style="ellipse;html=1;fillColor=#EFEFEC;strokeColor=#7A7A72;fontColor=#3A3A36;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="1350" width="130" height="44" as="geometry"/></mxCell>
        <mxCell id="f_end3" value="END" style="ellipse;html=1;fillColor=#EFEFEC;strokeColor=#7A7A72;fontColor=#3A3A36;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="815" y="1350" width="130" height="44" as="geometry"/></mxCell>

        <mxCell id="fe1a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;" edge="1" parent="1" source="f_start" target="f_d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe2a" value="no &#8212; first turn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;fontSize=10;fontColor=#4A4A44;" edge="1" parent="1" source="f_d1" target="f_intake"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe3a" value="yes &#8212; skip the second call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E6F4E;fontSize=10;fontColor=#1E4D36;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f_d1" target="f_suggest">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="178"/><mxPoint x="850" y="497"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="fe4a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;" edge="1" parent="1" source="f_intake" target="f_d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe5a" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;fontSize=10;fontColor=#4A4A44;" edge="1" parent="1" source="f_d2" target="f_end1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe6a" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;fontSize=10;fontColor=#4A4A44;" edge="1" parent="1" source="f_d2" target="f_suggest"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe7a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;" edge="1" parent="1" source="f_suggest" target="f_classify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe8a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;" edge="1" parent="1" source="f_classify" target="f_extract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe9a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;" edge="1" parent="1" source="f_extract" target="f_derive"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe10a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;" edge="1" parent="1" source="f_derive" target="f_d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe11a" value="yes &#8212; no clause is drafted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E6F4E;fontSize=10;fontColor=#1E4D36;" edge="1" parent="1" source="f_d3" target="f_gate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe12a" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;fontSize=10;fontColor=#4A4A44;" edge="1" parent="1" source="f_d3" target="f_propose"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe13a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f_propose" target="f_gate">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="979"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="fe14a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;" edge="1" parent="1" source="f_gate" target="f_respond"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe15a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;" edge="1" parent="1" source="f_respond" target="f_d4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe16a" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A63D40;fontSize=10;fontColor=#7A2E30;" edge="1" parent="1" source="f_d4" target="f_park"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe17a" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E6F4E;fontSize=10;fontColor=#1E4D36;" edge="1" parent="1" source="f_d4" target="f_record"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe18a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;" edge="1" parent="1" source="f_park" target="f_end2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe19a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;" edge="1" parent="1" source="f_record" target="f_end3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="f_note" value="Abstraction runs &lt;b&gt;before&lt;/b&gt; the gate, so a parked case still contributes candidate logic &#8212;&lt;br&gt;otherwise the logic of the hardest decisions would be the logic never written down." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6A6A62;" vertex="1" parent="1">
          <mxGeometry x="740" y="910" width="390" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ================================================================= -->
  <!-- PAGE 3 — Oversight loop                                           -->
  <!-- ================================================================= -->
  <diagram name="Oversight loop" id="page-loop">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="o_ttl" value="Where human judgement enters, and why it is not asked twice" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F4459;" vertex="1" parent="1">
          <mxGeometry x="60" y="14" width="800" height="34" as="geometry"/>
        </mxCell>

        <mxCell id="o_case"  value="A case arrives" style="rounded=1;arcSize=20;html=1;fillColor=#FBF0F0;strokeColor=#A63D40;fontColor=#7A2E30;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="92" width="200" height="58" as="geometry"/></mxCell>
        <mxCell id="o_mx"    value="The matrix classifies it&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;harm · reversibility · rights · confidence&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#E2EEE6;strokeColor=#2E6F4E;fontColor=#1E4D36;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="92" width="260" height="58" as="geometry"/></mxCell>
        <mxCell id="o_gate"  value="Does approved logic&lt;br&gt;cover this case ?" style="rhombus;html=1;fillColor=#F4FAF6;strokeColor=#2E6F4E;fontColor=#1E4D36;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="76" width="280" height="92" as="geometry"/></mxCell>

        <mxCell id="o_park"  value="1 &#183; Park&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;nothing is said to the person waiting&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#F8E9E9;strokeColor=#A63D40;fontColor=#7A2E30;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1050" y="88" width="290" height="62" as="geometry"/></mxCell>
        <mxCell id="o_rev"   value="2 &#183; The expert reads the &lt;b&gt;prepared answer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;and may edit it &#8212; a reviewer who may only accept&lt;br&gt;or refuse is signing, not reviewing&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#F8E9E9;strokeColor=#A63D40;fontColor=#7A2E30;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="188" width="290" height="76" as="geometry"/></mxCell>
        <mxCell id="o_appr"  value="3 &#183; They approve the answer&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;attributed to them, marked as revised&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#F8E9E9;strokeColor=#A63D40;fontColor=#7A2E30;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="302" width="290" height="62" as="geometry"/></mxCell>
        <mxCell id="o_clause" value="4 &#183; The clause behind it is offered&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;approved in the same interaction, not silently&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#F8E9E9;strokeColor=#A63D40;fontColor=#7A2E30;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="402" width="290" height="62" as="geometry"/></mxCell>

        <mxCell id="o_store" value="5 &#183; It enters the base under a canonical key&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;carrying the approver&#8217;s name, an append-only history,&lt;br&gt;a usage count and an audit tally&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#EDEAF2;strokeColor=#5A4A7A;fontColor=#40335C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="560" width="360" height="80" as="geometry"/></mxCell>

        <mxCell id="o_next"  value="6 &#183; The next case of the same shape&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;is covered, and nobody waits&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#E2EEE6;strokeColor=#2E6F4E;fontColor=#1E4D36;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="569" width="260" height="62" as="geometry"/></mxCell>

        <mxCell id="o_yes"   value="Decided from approved logic&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;same facts &#8594; same answer &#8594; same derivation,&lt;br&gt;attached to the decision&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#E2EEE6;strokeColor=#2E6F4E;fontColor=#1E4D36;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="270" width="320" height="76" as="geometry"/></mxCell>
        <mxCell id="o_audit" value="A proportion is sampled for audit&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;deterministically, by case id &#8212; and the rate is&lt;br&gt;highest where a wrong decision hurts most&lt;/font&gt;" style="rounded=1;arcSize=20;html=1;fillColor=#FBF1E6;strokeColor=#8C6A3F;fontColor=#6B4F2E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="400" width="320" height="76" as="geometry"/></mxCell>

        <mxCell id="oe1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;" edge="1" parent="1" source="o_case" target="o_mx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A7A72;" edge="1" parent="1" source="o_mx" target="o_gate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe3" value="no, and the tier is consequential" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A63D40;fontSize=10;fontColor=#7A2E30;" edge="1" parent="1" source="o_gate" target="o_park"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A63D40;" edge="1" parent="1" source="o_park" target="o_rev"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A63D40;" edge="1" parent="1" source="o_rev" target="o_appr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A63D40;" edge="1" parent="1" source="o_appr" target="o_clause"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A4A7A;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_clause" target="o_store">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1195" y="600"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="oe8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E6F4E;" edge="1" parent="1" source="o_store" target="o_next"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="oe9" value="and every case after it" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E6F4E;dashed=1;fontSize=11;fontColor=#1E4D36;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_next" target="o_gate">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="520"/><mxPoint x="770" y="520"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="oe10" value="yes &#8212; at every tier, including the top one" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E6F4E;fontSize=10;fontColor=#1E4D36;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o_gate" target="o_yes">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="122"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="oe11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C6A3F;" edge="1" parent="1" source="o_yes" target="o_audit"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="o_key" value="The expert is asked once, about the &lt;b&gt;clause&lt;/b&gt; &#8212; not once per case.&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;That is the choice of unit: judgement is spent on logic, which is reusable,&lt;br&gt;rather than on instances, which are not.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;fillColor=#FAFAF8;strokeColor=#C9C9C2;fontColor=#3A3A36;fontSize=13;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="700" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="o_key2" value="What this does &lt;b&gt;not&lt;/b&gt; claim: that the clause is right.&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;An approved clause decides badly until someone notices. The audit sample,&lt;br&gt;the per-rule tally and retirement with impact analysis are how it is noticed.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;fillColor=#FBF0F0;strokeColor=#D8A9AB;fontColor=#7A2E30;fontSize=13;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="700" width="540" height="96" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
