<script>const RecruitmentEngine = (() => {
  'use strict';
  const defaults = [
    {name:'North branch',role:'Customer Support Specialist',target:250,years:1,skills:['Customer service','Written communication'],credential:''},
    {name:'South branch',role:'Operations Coordinator',target:250,years:2,skills:['Scheduling','Digital records'],credential:''},
    {name:'East branch',role:'Sales Associate',target:250,years:1,skills:['Customer service','Sales reporting'],credential:''},
    {name:'West branch',role:'IT Support Analyst',target:250,years:2,skills:['Troubleshooting','Technical communication'],credential:''}
  ];
  const clone=x=>JSON.parse(JSON.stringify(x));
  const norm=x=>String(x).trim().toLowerCase();
  function hash(s){let h=2166136261;for(const ch of s){h^=ch.charCodeAt(0);h=Math.imul(h,16777619)}return h>>>0}
  function validate(branches){
    if(branches.length!==4)throw Error('This campaign needs exactly four branches.');
    if(branches.reduce((n,b)=>n+Number(b.target),0)!==1000)throw Error('The four branch targets must add up to exactly 1,000 hires.');
    for(const b of branches){
      if(!b.name.trim()||!b.role.trim())throw Error('Give every branch a name and job role.');
      if(!Number.isInteger(b.target)||b.target<1)throw Error('Each hiring target must be a positive whole number.');
      if(!Number.isFinite(b.years)||b.years<0||b.years>30)throw Error('Minimum experience must be between 0 and 30 years.');
      if(!b.skills.length||b.skills.length>5||b.skills.some(s=>!s.trim()))throw Error('Enter one to five essential skills for each role.');
      if(new Set(b.skills.map(norm)).size!==b.skills.length)throw Error('Each role must list distinct essential skills.');
    }
  }
  function create(branches=defaults,options={}){
    validate(branches);const count=options.count??8000;
    if(!Number.isInteger(count)||count<100||count%100!==0)throw Error('The sample size must be a positive multiple of 100.');
    const audit=options.audit??10;if(!Number.isInteger(audit)||audit<0||audit>100)throw Error('Rejection sampling must be between 0% and 100%.');
    const campaign={branches:clone(branches),autoReject:options.autoReject!==false,audit,owner:'',stage:'ready',createdAt:new Date().toISOString(),candidates:[],agents:[],events:[],sequence:0,rejectionCount:0};
    for(let a=0;a<100;a++)campaign.agents.push({id:'A'+String(a+1).padStart(3,'0'),branch:Math.floor(a/25),queue:[],processed:0,flagged:0,rejected:0,last:null});
    for(let i=0;i<count;i++){
      const branch=i%4,b=branches[branch],id='CV'+String(i+1).padStart(5,'0'),bucket=hash(id+':sample')%10,agent=branch*25+Math.floor(i/4)%25;
      const skillEvidence={};for(const skill of b.skills)skillEvidence[norm(skill)]={value:true,text:'The fictional CV describes practical work using '+skill+'.'};
      const c={id,branch,agent,appliedRole:b.role,years:b.years+1+(hash(id+':experience')%5),skillEvidence,credentials:{},conflict:bucket===9,status:'queued',origin:null,assessment:null,agentDecision:null,auditPending:false,auditSelected:false,history:[],hiredAt:null};
      if(b.credential.trim())c.credentials[norm(b.credential)]={value:true,text:'The supplied screening answer confirms a current '+b.credential+'.'};
      if(bucket>=5&&bucket<=7){if(hash(id+':failure')%2&&b.years>0)c.years=Math.max(0,b.years-1);else c.skillEvidence[norm(b.skills[0])]={value:false,text:'The supplied screening answer explicitly states no experience with '+b.skills[0]+'.'};}
      if(bucket===8){c.skillEvidence[norm(b.skills[0])]={value:null,text:'This skill is not established by the supplied CV or screening answers.'};if(hash(id)%2)c.years=null;}
      c.cvSummary='Applicant for '+b.role+'. '+(c.years===null?'Relevant work duration is not clear in the CV.':c.years+' years of relevant work reported in the supplied CV.')+(c.conflict?' The timeline conflicts with a screening answer; the extract needs human verification.':'');
      campaign.candidates.push(c);campaign.agents[agent].queue.push(i);
    }
    return campaign;
  }
  function assessment(c,b,autoReject){
    const checks=[{requirement:'At least '+b.years+' year'+(b.years===1?'':'s')+' of relevant experience',result:c.years===null?'unknown':c.years>=b.years?'met':'not_met',evidence:c.years===null?'Relevant duration is unclear.':c.years+' years explicitly reported in the supplied CV.'}];
    for(const skill of b.skills){const e=c.skillEvidence[norm(skill)];checks.push({requirement:skill,result:!e||e.value===null?'unknown':e.value?'met':'not_met',evidence:e?.text||'No usable evidence in this supplied sample.'})}
    if(b.credential.trim()){const e=c.credentials[norm(b.credential)];checks.push({requirement:'Current '+b.credential,result:!e||e.value===null?'unknown':e.value?'met':'not_met',evidence:e?.text||'Credential not established by the supplied evidence.'})}
    const failed=checks.filter(x=>x.result==='not_met'),unknown=checks.filter(x=>x.result==='unknown');
    if(c.conflict)return {status:'review',code:'conflict',reason:'Conflicting evidence: a person must verify the CV and screening answers.',checks};
    if(unknown.length)return {status:'review',code:'missing',reason:'Evidence is missing or unclear. Missing information is not treated as a failure.',checks};
    if(failed.length)return {status:autoReject?'rejected':'review',code:'mismatch',reason:(autoReject?'Confirmed mismatch: ':'Human review required by policy: ')+failed.map(x=>x.requirement).join('; ')+'.',checks};
    return {status:'review',code:'match',reason:'All supplied essential requirements are met. A recruiter must decide whether to advance this applicant.',checks};
  }
  function event(campaign,actor,action,detail,candidate=null,extra={}){const e={sequence:++campaign.sequence,time:new Date().toISOString(),actor,action,detail,candidateId:candidate?.id||null,branch:candidate?campaign.branches[candidate.branch].name:null,...extra};campaign.events.push(e);if(candidate)candidate.history.push(e);return e}
  function start(campaign,owner,authorised){
    if(!owner.trim())throw Error('Name the accountable recruiter before starting.');
    if(!authorised)throw Error('Review the role specifications and authorise the screening policy.');
    if(campaign.stage==='running')return;
    if(campaign.agents.every(a=>a.processed===a.queue.length))throw Error('All CVs have been screened. Continue with human review.');
    campaign.owner=owner.trim();campaign.stage='running';event(campaign,campaign.owner,'Screening authorised','100 simulated agents may flag CVs'+(campaign.autoReject?' or reject confirmed mismatches.':'; autonomous rejection is disabled.'),null,{autoReject:campaign.autoReject,rejectionAuditPercent:campaign.audit});
  }
  function tick(campaign,batch=1){
    if(campaign.stage!=='running')return 0;let processed=0;
    for(const a of campaign.agents){for(let n=0;n<batch&&a.processed<a.queue.length;n++){
      const c=campaign.candidates[a.queue[a.processed]],result=assessment(c,campaign.branches[c.branch],campaign.autoReject);
      c.assessment=result;c.status=result.status;c.agentDecision=result.status;c.origin='agent';
      if(result.status==='rejected'){campaign.rejectionCount++;c.auditSelected=Math.floor(campaign.rejectionCount*campaign.audit/100)>Math.floor((campaign.rejectionCount-1)*campaign.audit/100)}
      c.auditPending=c.auditSelected;
      a.processed++;a.last=c.id;if(c.status==='rejected')a.rejected++;else a.flagged++;processed++;
      event(campaign,a.id,c.status==='rejected'?'Agent rejected':'Agent flagged',result.reason,c,{reasonCode:result.code,auditSelected:c.auditSelected});
    }}
    if(campaign.agents.every(a=>a.processed===a.queue.length)){campaign.stage='complete';event(campaign,'System','Screening complete','Every CV has one recorded agent screening decision. Hiring decisions remain with the recruiter.');}
    return processed;
  }
  function pause(campaign,stop=false){if(campaign.stage!=='running')return;campaign.stage=stop?'stopped':'paused';event(campaign,campaign.owner,stop?'All agents stopped':'Screening paused',stop?'No more CVs will be screened until the recruiter authorises a restart.':'Agent queues are retained for resuming.');}
  function stats(campaign){const s={total:campaign.candidates.length,screened:0,flagged:0,agentRejected:0,review:0,held:0,shortlisted:0,hired:0,rejected:0,auditPending:0,overrides:0,byBranch:campaign.branches.map(()=>({hired:0,review:0,screened:0}))};
    for(const c of campaign.candidates){if(c.agentDecision){s.screened++;s.byBranch[c.branch].screened++}if(c.agentDecision==='review')s.flagged++;if(c.status==='rejected'){s.rejected++;if(c.origin==='agent')s.agentRejected++}if(c.status==='review'){s.review++;s.byBranch[c.branch].review++}if(c.status==='held')s.held++;if(c.status==='shortlisted')s.shortlisted++;if(c.status==='hired'){s.hired++;s.byBranch[c.branch].hired++}if(c.auditPending)s.auditPending++;}
    s.overrides=campaign.events.filter(e=>e.action==='Rejection overturned').length;return s;
  }
  function decide(campaign,id,action,input){
    const c=campaign.candidates.find(c=>c.id===id);if(!c)throw Error('Choose an applicant.');
    if(c.status==='queued')throw Error('Wait until an agent has screened this CV.');
    if(!input.owner?.trim())throw Error('Name the accountable recruiter.');
    if(!input.reason?.trim())throw Error('Record the reason for this human decision.');
    if(!input.evidenceReviewed||!input.impactReviewed)throw Error('Review the role evidence and consider the applicant’s opportunity to correct it.');
    const before=c.status;let actionLabel,detail=input.reason.trim();
    if(action==='shortlist'){if(before!=='review')throw Error('Reopen the application for review before shortlisting.');c.status='shortlisted';actionLabel='Human shortlisted';}
    else if(action==='hire'){if(before!=='shortlisted')throw Error('Shortlist the applicant before recording a hire.');if(stats(campaign).byBranch[c.branch].hired>=campaign.branches[c.branch].target)throw Error('This branch has reached its hiring target. No additional hire was recorded.');c.status='hired';c.hiredAt=new Date().toISOString();actionLabel='Human recorded hire';}
    else if(action==='reject'){if(!['review','shortlisted'].includes(before))throw Error('Only an application under review or shortlisted can be rejected.');c.status='rejected';c.origin='human';actionLabel='Human rejected';}
    else if(action==='reopen'){if(!['rejected','held','shortlisted','hired'].includes(before))throw Error('This application is already in the review queue.');c.status='review';c.hiredAt=null;actionLabel=before==='rejected'?'Rejection overturned':before==='hired'?'Hire record corrected':'Human reopened';}
    else if(action==='escalate'){if(!['review','shortlisted'].includes(before))throw Error('Reopen the application before escalating.');if(!input.reviewer?.trim())throw Error('Name the reviewer for this escalation.');c.status='held';actionLabel='Human escalated';detail+=' Review owner: '+input.reviewer.trim()+'.';}
    else if(action==='confirm'){if(before!=='rejected'||c.origin!=='agent')throw Error('Choose an agent rejection to audit.');c.auditPending=false;actionLabel='Rejection audit confirmed';}
    else throw Error('Unknown review action.');
    if(action!=='confirm'){c.auditPending=false;if(action!=='reopen')c.origin='human';}
    event(campaign,input.owner.trim(),actionLabel,detail,c,{before,after:c.status,evidenceReviewed:true,correctionRouteConsidered:true,reviewer:input.reviewer?.trim()||null});return c;
  }
  function exportRecord(campaign){return {title:'Decision Partner — Recruitment campaign',simulation:true,exportedAt:new Date().toISOString(),createdAt:campaign.createdAt,owner:campaign.owner,stage:campaign.stage,targets:{total:1000,branches:clone(campaign.branches)},policy:{agents:100,agentsPerBranch:25,autoReject:campaign.autoReject,rejectionAuditPercent:campaign.audit,missingEvidence:'Human review',conflictingEvidence:'Human review'},metrics:stats(campaign),candidates:campaign.candidates.map(c=>({id:c.id,branch:campaign.branches[c.branch].name,agent:campaign.agents[c.agent].id,status:c.status,origin:c.origin,agentDecision:c.agentDecision,assessment:clone(c.assessment),auditPending:c.auditPending,hiredAt:c.hiredAt})),events:clone(campaign.events)};}
  return {defaults,clone,create,assessment,start,tick,pause,stats,decide,exportRecord,validate};
})();
</script>
<script>'use strict';
const E=RecruitmentEngine,$=id=>document.getElementById(id),fmt=n=>n.toLocaleString('en-GB');
const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const names={queued:'Awaiting screening',review:'Human review',rejected:'Rejected',shortlisted:'Shortlisted',held:'Escalated',hired:'Hired'};
const reasonNames={match:'Requirements met',missing:'Evidence unclear',conflict:'Conflicting evidence',mismatch:'Confirmed mismatch'};
let campaign=E.create(),previousCampaign=null,timer=null,page=0,selectedId=null,detailKey='',displayedEvents=-1;
const pageSize=20;
function message(text,error=false){$('message').hidden=!text;$('message').textContent=text;$('message').className='notice'+(error?' error':'');}
function safely(fn){try{fn()}catch(e){message(e.message,true)}}
function stopTimer(){if(timer!==null){clearInterval(timer);timer=null}}
function buildCampaignView(){
  $('branches').innerHTML=campaign.branches.map((b,i)=>`<article class="branch panel"><h3>${esc(b.name)}</h3><div class="role">${esc(b.role)}</div><div class="quota"><b id="branchHired${i}">0 <span>/ ${fmt(b.target)} hires</span></b><span id="branchRemaining${i}">${fmt(b.target)} to fill</span></div><div class="progress"><span id="branchBar${i}"></span></div><div class="branch-meta"><span>25 agents · 2,000 CVs</span><span id="branchScreened${i}">0 screened</span></div><div class="agent-grid" aria-label="${esc(b.name)} screening agents">${campaign.agents.filter(a=>a.branch===i).map(a=>`<button type="button" class="agent" id="agent-${a.id}" data-agent="${a.id}" aria-label="Inspect ${a.id}">${a.id}</button>`).join('')}</div></article>`).join('');
  $('branchFilter').innerHTML='<option value="all">All branches</option>'+campaign.branches.map((b,i)=>`<option value="${i}">${esc(b.name)}</option>`).join('');
  $('agentFilter').innerHTML='<option value="all">All 100 agents</option>'+campaign.agents.map(a=>`<option value="${a.id}">${a.id} · ${esc(campaign.branches[a.branch].name)}</option>`).join('');
  $('specFields').innerHTML=campaign.branches.map((b,i)=>`<div class="spec-card"><label for="bName${i}">Branch ${i+1} name</label><input type="text" id="bName${i}" maxlength="80" value="${esc(b.name)}" required><label for="bRole${i}">Job role</label><input type="text" id="bRole${i}" maxlength="100" value="${esc(b.role)}" required><div class="split"><div><label for="bTarget${i}">Hiring target</label><input id="bTarget${i}" type="number" value="${b.target}" min="1" max="997" step="1" required></div><div><label for="bYears${i}">Min. years</label><input id="bYears${i}" type="number" value="${b.years}" min="0" max="30" step="0.5" required></div></div><label for="bSkills${i}">Essential skills · comma-separated</label><textarea id="bSkills${i}" rows="2" maxlength="400" required>${esc(b.skills.join(', '))}</textarea><label for="bCredential${i}">Required credential · optional</label><input id="bCredential${i}" type="text" value="${esc(b.credential)}" maxlength="100"></div>`).join('');
  $('autoReject').value=campaign.autoReject?'yes':'no';$('auditRate').value=campaign.audit;$('authorise').checked=false;$('statusFilter').value='all';$('search').value='';page=0;selectedId=null;detailKey='';displayedEvents=-1;
}
function filtered(){const b=$('branchFilter').value,status=$('statusFilter').value,a=$('agentFilter').value,q=$('search').value.trim().toLowerCase();return campaign.candidates.filter(c=>{
  if(b!=='all'&&c.branch!==Number(b))return false;if(a!=='all'&&campaign.agents[c.agent].id!==a)return false;
  if(status==='audit'){if(!c.auditPending)return false}else if(status==='match'){if(c.status!=='review'||c.assessment?.code!=='match')return false}else if(status==='uncertain'){if(c.status!=='review'||!['missing','conflict'].includes(c.assessment?.code))return false}else if(status!=='all'&&c.status!==status)return false;
  return !q||[c.id,c.assessment?.reason||'',campaign.branches[c.branch].name,campaign.branches[c.branch].role].join(' ').toLowerCase().includes(q);
})}
function renderQueue(){const rows=filtered(),pages=Math.max(1,Math.ceil(rows.length/pageSize));page=Math.min(page,pages-1);const slice=rows.slice(page*pageSize,(page+1)*pageSize);
  $('queue').innerHTML=slice.map(c=>`<tr class="${selectedId===c.id?'selected':''}"><td><button type="button" class="cv-button" data-cv="${c.id}" aria-label="Review ${c.id}">${c.id}</button><small>${esc(campaign.branches[c.branch].name)}</small></td><td>${campaign.agents[c.agent].id}<small>${esc(campaign.branches[c.branch].role)}</small></td><td><span class="badge ${c.status}">${names[c.status]}</span><small>${esc(c.assessment?reasonNames[c.assessment.code]:'Queued for its assigned agent')}</small>${c.auditPending?'<span class="audit-dot">Human audit selected</span>':''}</td></tr>`).join('');
  $('queueEmpty').hidden=rows.length>0;$('pageSummary').textContent=rows.length?`${fmt(page*pageSize+1)}–${fmt(Math.min((page+1)*pageSize,rows.length))} of ${fmt(rows.length)} applicants`:'0 matching applicants';$('previous').disabled=page===0;$('next').disabled=page>=pages-1;
}
function renderInspector(force=false){
  const c=campaign.candidates.find(c=>c.id===selectedId);$('inspector').hidden=!c;$('inspectorEmpty').hidden=!!c;if(!c)return;
  $('signedBy').textContent='Recorded by: '+($('owner').value.trim()||'Name the accountable recruiter above.');
  const key=c.id+':'+c.status+':'+c.history.length;if(!force&&key===detailKey)return;detailKey=key;
  $('candidateId').textContent=c.id;$('candidateStatus').textContent=names[c.status];$('candidateStatus').className='badge '+c.status;$('candidateRole').textContent=campaign.branches[c.branch].name+' · '+campaign.branches[c.branch].role+' · Agent '+campaign.agents[c.agent].id;
  $('candidateReason').textContent=c.assessment?c.assessment.reason:'This CV has not been screened. Its assigned agent will check it when screening starts.';$('candidateReason').className='callout'+(c.status==='rejected'?' red':'');
  const checks=c.assessment?.checks||[];$('evidence').innerHTML=checks.map(ch=>`<li><div class="evidence-title"><span>${esc(ch.requirement)}</span><span class="result ${ch.result}">${{met:'✓ Met',not_met:'✕ Not met',unknown:'? Unclear'}[ch.result]}</span></div><p>${esc(ch.evidence)}</p></li>`).join('')||'<li class="hint">Evidence comparison appears after screening.</li>';
  $('cvText').innerHTML='<p>'+esc(c.cvSummary)+'</p>'+Object.entries(c.skillEvidence).map(([skill,e])=>'<p><b>'+esc(skill)+':</b> '+esc(e.text)+'</p>').join('')+Object.entries(c.credentials).map(([credential,e])=>'<p><b>'+esc(credential)+':</b> '+esc(e.text)+'</p>').join('')+'<p>Source: generated demo CV and explicit screening answers. No real applicant data.</p>';
  $('evidenceCheck').checked=false;$('impactCheck').checked=false;$('reason').value='';$('reviewer').value='';
  for(const id of ['evidenceCheck','impactCheck','reason','reviewer'])$(id).disabled=c.status==='queued';
  const action=(id,label,cls)=>`<button type="button" class="btn ${cls}" data-decision="${id}">${label}</button>`;let actions='';
  if(c.status==='review')actions=action('shortlist','Shortlist','good')+action('reject','Reject after review','danger')+action('escalate','Escalate','outline');
  if(c.status==='shortlisted')actions=action('hire','Record hire','good')+action('reject','Reject after review','danger')+action('escalate','Escalate','outline')+action('reopen','Return to review','outline');
  if(c.status==='rejected')actions=action('reopen','Overturn rejection','primary')+(c.origin==='agent'?action('confirm',c.auditPending?'Confirm sampled rejection':'Confirm rejection audit','outline'):'');
  if(c.status==='held')actions=action('reopen','Reopen after review','primary');
  if(c.status==='hired')actions=action('reopen','Correct / reopen hire record','outline');
  $('reviewActions').innerHTML=actions;$('decisionHint').textContent=c.status==='queued'?'A screening result is required before a human decision can be recorded.':c.status==='hired'?'Reopening corrects the local hire count and returns this applicant to review.':c.status==='rejected'?'Every rejection can be challenged. Overturning returns this CV to the human review queue.':c.status==='shortlisted'?'A human may record a hire after verifying the role requirements. Branch targets cannot be exceeded.':'Complete both checks and give reasons. If evidence is unclear, verify it or escalate before advancing.';
  $('candidateHistory').innerHTML=c.history.map(e=>`<li><time>${new Date(e.time).toLocaleTimeString()} · ${esc(e.actor)}</time><b>${esc(e.action)}</b><br>${esc(e.detail)}</li>`).join('')||'<li class="hint">No decision recorded.</li>';
}
function render(){const s=E.stats(campaign);$('mHired').textContent=fmt(s.hired);$('mScreened').textContent=fmt(s.screened);$('mReview').textContent=fmt(s.review);$('mRejected').textContent=fmt(s.agentRejected);$('mAudit').textContent=fmt(s.auditPending);$('reviewSub').textContent=fmt(s.shortlisted)+' shortlisted · '+fmt(s.held)+' escalated';$('overrideSub').textContent=fmt(s.overrides)+' rejections overturned';$('screenProgress').setAttribute('aria-valuenow',s.screened);$('screenBar').style.width=100*s.screened/s.total+'%';
  const status={ready:'Ready to screen',running:'Screening in progress',paused:'Paused by recruiter',stopped:'All agents stopped',complete:'Screening complete'};$('runStatus').textContent=status[campaign.stage];$('runDetail').textContent=' · '+fmt(s.screened)+' / '+fmt(s.total)+' CVs';$('policySummary').textContent=campaign.autoReject?`Confirmed mismatches may be rejected. ${campaign.audit}% of rejections are sampled for review.`:'All CVs are flagged for a human decision. Autonomous rejection is disabled.';
  $('start').textContent=['paused','stopped'].includes(campaign.stage)?'Resume 100 agents':campaign.stage==='complete'?'All CVs screened':'Start 100 agents';$('start').disabled=['running','complete'].includes(campaign.stage);$('pause').disabled=campaign.stage!=='running';$('stop').disabled=campaign.stage!=='running';$('owner').disabled=campaign.stage==='running';
  for(const el of $('specForm').querySelectorAll('input,textarea,select,button'))el.disabled=campaign.stage==='running'&&el.id!=='speed';$('undoReset').hidden=!previousCampaign;
  let done=0;campaign.branches.forEach((b,i)=>{$('branchHired'+i).innerHTML=fmt(s.byBranch[i].hired)+` <span>/ ${fmt(b.target)} hires</span>`;$('branchRemaining'+i).textContent=fmt(b.target-s.byBranch[i].hired)+' to fill';$('branchBar'+i).style.width=Math.min(100,100*s.byBranch[i].hired/b.target)+'%';$('branchScreened'+i).textContent=fmt(s.byBranch[i].screened)+' screened';});
  for(const a of campaign.agents){const completed=a.processed===a.queue.length;if(completed)done++;const mode=completed?'done':campaign.stage==='running'?'live':['paused','stopped'].includes(campaign.stage)?'paused':'';const btn=$('agent-'+a.id);btn.className='agent '+mode+($('agentFilter').value===a.id?' selected':'');const description=`${a.id}: ${completed?'complete':campaign.stage}, ${a.processed}/${a.queue.length} CVs screened, ${a.flagged} flagged, ${a.rejected} rejected`;btn.title=description;btn.setAttribute('aria-label','Inspect '+description)}
  $('fleetTotal').textContent=done===100?'100 / 100 agents complete':campaign.stage==='running'?`${100-done} agents screening · ${done} complete`:`100 agents · ${done} complete`;
  if(displayedEvents!==campaign.events.length){displayedEvents=campaign.events.length;$('eventSummary').textContent=fmt(campaign.events.length)+' events · agent outcomes and human reasoning included in the full download.';const human=campaign.events.filter(e=>!/^A\d{3}$/.test(e.actor)).slice(-25).reverse();$('campaignLog').innerHTML=human.map(e=>`<li><time>${new Date(e.time).toLocaleTimeString()} · ${esc(e.actor)}${e.candidateId?' · '+e.candidateId:''}</time><b>${esc(e.action)}</b> — ${esc(e.detail)}</li>`).join('')||'<li class="hint">Campaign events appear when you authorise screening.</li>';}
  renderQueue();renderInspector();
}
function start(){safely(()=>{E.start(campaign,$('owner').value,$('authorise').checked);message('Screening authorised. Each agent handles its own assigned CVs; hiring remains a human decision.');stopTimer();render();const current=campaign;timer=setInterval(()=>{if(current!==campaign||campaign.stage!=='running'){stopTimer();return}E.tick(campaign,Number($('speed').value));render();if(campaign.stage==='complete'){stopTimer();message('All 8,000 fictional CVs have been screened. Review flagged cases and sample the automatic rejections.')}},200);});}
function selectCandidate(id,scroll=false){selectedId=id;detailKey='';renderQueue();renderInspector(true);if(scroll&&window.matchMedia('(max-width:760px)').matches)$('inspector').scrollIntoView({behavior:'smooth',block:'start'});}
$('start').addEventListener('click',start);
$('pause').addEventListener('click',()=>{stopTimer();E.pause(campaign);render();message('Screening paused. Agent queues are saved and the recruiter can review applicants.');});
$('stop').addEventListener('click',()=>{stopTimer();E.pause(campaign,true);$('authorise').checked=false;render();message('All agents stopped. Fresh authorisation is required to resume screening.');});
$('authorise').addEventListener('change',()=>{if(!$('authorise').checked&&campaign.stage==='running'){stopTimer();E.pause(campaign,true);render();message('Authorisation withdrawn. All agents have stopped.');}});
$('owner').addEventListener('input',()=>renderInspector());
for(const id of ['branchFilter','statusFilter','agentFilter'])$(id).addEventListener('change',()=>{page=0;render()});$('search').addEventListener('input',()=>{page=0;renderQueue()});
$('clearFilters').addEventListener('click',()=>{$('branchFilter').value='all';$('statusFilter').value='all';$('agentFilter').value='all';$('search').value='';page=0;render()});
$('showAudits').addEventListener('click',()=>{$('branchFilter').value='all';$('agentFilter').value='all';$('statusFilter').value='audit';$('search').value='';page=0;renderQueue();const first=filtered()[0];if(first)selectCandidate(first.id);else message('There are no rejection audits pending in this campaign.');});
$('previous').addEventListener('click',()=>{page--;renderQueue()});$('next').addEventListener('click',()=>{page++;renderQueue()});
$('queue').addEventListener('click',e=>{const btn=e.target.closest('[data-cv]');if(btn)selectCandidate(btn.dataset.cv,true)});
$('branches').addEventListener('click',e=>{const btn=e.target.closest('[data-agent]');if(!btn)return;const agent=campaign.agents.find(a=>a.id===btn.dataset.agent);$('agentFilter').value=agent.id;$('branchFilter').value='all';$('statusFilter').value='all';$('search').value='';page=0;render();selectCandidate(agent.last||campaign.candidates[agent.queue[0]].id);});
$('reviewActions').addEventListener('click',e=>{const btn=e.target.closest('[data-decision]');if(!btn)return;safely(()=>{const c=E.decide(campaign,selectedId,btn.dataset.decision,{owner:$('owner').value,reason:$('reason').value,evidenceReviewed:$('evidenceCheck').checked,impactReviewed:$('impactCheck').checked,reviewer:$('reviewer').value});message(c.id+': '+names[c.status]+'. The human decision and reasons are recorded.');render();});});
$('specForm').addEventListener('submit',e=>{e.preventDefault();safely(()=>{if(campaign.stage==='running')throw Error('Pause or stop screening before changing the campaign.');const branches=Array.from({length:4},(_,i)=>({name:$('bName'+i).value.trim(),role:$('bRole'+i).value.trim(),target:Number($('bTarget'+i).value),years:Number($('bYears'+i).value),skills:$('bSkills'+i).value.split(',').map(x=>x.trim()).filter(Boolean),credential:$('bCredential'+i).value.trim()}));const next=E.create(branches,{autoReject:$('autoReject').value==='yes',audit:Number($('auditRate').value)});stopTimer();previousCampaign=campaign;campaign=next;buildCampaignView();render();message('Fresh fictional CVs loaded for the updated specifications. Review the policy and authorise the new campaign.');});});
$('undoReset').addEventListener('click',()=>{if(!previousCampaign)return;stopTimer();campaign=previousCampaign;previousCampaign=null;$('owner').value=campaign.owner;buildCampaignView();render();message('The previous campaign and all its decisions have been restored.');});
function download(content,type,name){const blob=new Blob([content],{type}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000)}
$('exportJson').addEventListener('click',()=>download(JSON.stringify(E.exportRecord(campaign),null,2),'application/json','recruitment_decision_record.json'));
$('exportCsv').addEventListener('click',()=>{const cell=x=>'"'+String(x??'').replace(/^[=+@\-\t\r]/,"'$&").replace(/"/g,'""')+'"';const rows=[['CV ID','Branch','Role','Agent','Current status','Screening reason','Pending rejection audit','Latest actor','Latest human reason'],...campaign.candidates.map(c=>{const human=c.history.filter(e=>!/^A\d{3}$/.test(e.actor)).at(-1);return[c.id,campaign.branches[c.branch].name,campaign.branches[c.branch].role,campaign.agents[c.agent].id,names[c.status],c.assessment?.reason||'',c.auditPending?'Yes':'No',human?.actor||'',human?.detail||'']})];download('\uFEFF'+rows.map(row=>row.map(cell).join(',')).join('\r\n'),'text/csv;charset=utf-8','recruitment_applicant_decisions.csv');});
buildCampaignView();render();
</script>
</body></html>


