# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Pick ONE provider. The key for the other can stay commented out.

# --- Anthropic (default) ---------------------------------------------------
LLM_PROVIDER="anthropic"
ANTHROPIC_API_KEY="sk-ant-api03-..."

# --- OpenAI ----------------------------------------------------------------
# LLM_PROVIDER="openai"
# OPENAI_API_KEY="sk-..."
#
# Optional. The three tiers the page offers, cheapest first. Defaults are
# gpt-4o-mini / gpt-4o / gpt-4.1; override if your account has different
# models. `python check_setup.py` reports which of them it can actually reach.
# OPENAI_MODEL_SMALL="gpt-4o-mini"
# OPENAI_MODEL_MEDIUM="gpt-4o"
# OPENAI_MODEL_LARGE="gpt-4.1"
#
# Optional. Any OpenAI-compatible server: Azure OpenAI, vLLM, Ollama,
# OpenRouter, LM Studio.
# OPENAI_BASE_URL="http://localhost:11434/v1"
